<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM padre del TP "Sistema de Gestión Médica y Monitoreo de Pacientes con Telemedicina".
  Agrupa los 4 módulos (Maven multi-módulo) y fija las versiones comunes.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>ar.edu.palermo.telemedicina</groupId>
    <artifactId>telemedicina</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>telemedicina</name>
    <description>TP Telemedicina - Universidad de Palermo</description>

    <modules>
        <module>core-service</module>
        <module>metricas-service</module>
        <module>notificaciones-service</module>
        <module>iot-simulator</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
