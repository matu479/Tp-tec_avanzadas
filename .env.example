# Copiá este archivo a .env si querés cambiar algún valor (no es obligatorio).

# --- Puertos en la máquina (host) ---
# Si el 8080 está ocupado (por ejemplo, por Oracle), cambiá CORE_PUERTO a 8090.
CORE_PUERTO=8080
METRICAS_PUERTO=8081
NOTIFICACIONES_PUERTO=8082
MAILHOG_PUERTO=8025
FRONT_PUERTO=3000

# --- Base relacional ---
POSTGRES_DB=telemedicina
POSTGRES_USER=telemedicina
POSTGRES_PASSWORD=telemedicina

# --- Zona horaria de los contenedores ---
TZ=America/Argentina/Buenos_Aires

# --- Notificaciones ---
# Destino de las alertas de pacientes sin profesional asignado
EMAIL_GUARDIA=guardia@tp.com
# Opcional: email real de los profesionales de prueba (vacío = clinica@tp.com y cardio@tp.com)
EMAIL_PROFESIONAL_CLINICA=
EMAIL_PROFESIONAL_CARDIO=

# --- Simulador IoT ---
INTERVALO_SEGUNDOS=5
# Probabilidad de que una métrica salga fuera de rango (0 = nunca; 0.05 = 5 %).
# Con 0, las alertas aparecen solo con ESCENARIO_CRITICO=true.
PROBABILIDAD_FUERA_RANGO=0
# true: a los 20 segundos manda una saturación de 87 % (demo de la alerta)
ESCENARIO_CRITICO=false
